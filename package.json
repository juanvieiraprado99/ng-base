{
  "name": "ng-base-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:cli": "pnpm --filter ngx-base-cli build",
    "dev": "pnpm --filter ngx-base-cli dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "e2e": "pnpm --filter ngx-base-cli e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15"
  }
}
