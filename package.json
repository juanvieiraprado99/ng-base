{
  "name": "ngx-base-cli",
  "version": "0.1.0-beta.2",
  "description": "CLI to scaffold an HTTP core (ApiClient, response cache, auth/error interceptors) into Angular projects — shadcn/ui style, the code lives in your repo",
  "license": "MIT",
  "author": "",
  "type": "module",
  "bin": "./dist/index.js",
  "files": [
    "dist",
    "schema.json"
  ],
  "scripts": {
    "build": "tsup && node ./scripts/copy-templates.mjs && npm run schema",
    "prepublishOnly": "npm run build",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "schema": "tsx scripts/build-schema.ts",
    "e2e": "npm run build && node scripts/e2e.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@clack/prompts": "^0.10.0",
    "commander": "^13.1.0",
    "diff": "^9.0.0",
    "fs-extra": "^11.3.0",
    "jsonc-parser": "^3.3.1",
    "picocolors": "^1.1.1",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/diff": "^7.0.2",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.14.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.7"
  },
  "keywords": [
    "angular",
    "cli",
    "http",
    "cache",
    "scaffold"
  ]
}
