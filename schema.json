{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://unpkg.com/ng-base/schema.json",
  "title": "ng-base config (.ng-base.json)",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "outputDir": {
      "type": "string",
      "description": "Folder (relative to the project root) where the core is generated.",
      "default": "src/app/core"
    },
    "baseApiUrl": {
      "type": "string",
      "description": "API base URL written to src/environments/environment*.ts (BASE_API_URL).",
      "default": "https://api.example.com"
    },
    "importStyle": {
      "type": "string",
      "description": "alias = @core/@layout/@pages/@shared (tsconfig paths); relative = ../ imports.",
      "enum": [
        "alias",
        "relative"
      ],
      "default": "alias"
    },
    "useHttpResource": {
      "type": "boolean",
      "description": "ApiClient.resource() for httpResource (Angular 19.2+).",
      "default": false
    },
    "storageEngine": {
      "type": "string",
      "description": "CACHE_STORAGE backend for the response cache (SSR-safe).",
      "enum": [
        "localStorage",
        "sessionStorage",
        "memory"
      ],
      "default": "localStorage"
    },
    "naming": {
      "type": "string",
      "description": "File/class naming: \"modern\" (user-card.ts, Angular v20 style guide) or \"suffixed\" (user-card.component.ts). Missing = \"suffixed\".",
      "enum": [
        "modern",
        "suffixed"
      ],
      "default": "suffixed"
    },
    "project": {
      "type": "string",
      "description": "angular.json project to target; empty = auto-detect.",
      "default": ""
    },
    "modules": {
      "type": "array",
      "description": "Modules installed with `ng-base add` (auth, errors, logging, layout).",
      "items": {
        "type": "string",
        "enum": [
          "auth",
          "errors",
          "logging",
          "layout"
        ]
      },
      "uniqueItems": true,
      "default": []
    }
  },
  "additionalProperties": false
}
